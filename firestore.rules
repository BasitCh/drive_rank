// DriveRank Firestore security rules.
//
// Paste this into Firebase Console → Firestore Database → Rules and
// hit Publish. (Or `firebase deploy --only firestore:rules` from this
// repo root once your local Firebase CLI auth is set up.)
//
// Every signed-in user gets `request.auth.uid`. Anonymous sign-in
// fires at bootstrap time (FirebaseAuthService.ensureSignedIn), so
// every Firestore call from the app is authenticated.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    match /usernames/{username} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && !exists(/databases/$(database)/documents/usernames/$(username));
      allow update, delete: if false;
    }

    match /leaderboard/{segment}/entries/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == uid;
    }

    match /friend_requests/{requestId} {
      allow read: if request.auth != null && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid;
      allow delete: if false;
    }

    match /friends/{uid}/friendList/{friendUid} {
      allow read: if request.auth.uid == uid;
      allow write: if request.auth.uid == uid
        || request.auth.uid == friendUid;
    }
  }
}
