rules_version = '2';

// =============================================================================
// DriveRank Firestore security rules
// =============================================================================
//
// Collections:
//   - `device_trials/{hash}` — the anti-abuse free-trip counter, keyed by
//     a sha256 hash of the device's ANDROID_ID (Android) or
//     identifierForVendor (iOS). No PII, doc ids are unguessable.
//   - `public_profiles/{uid}` — the deliberately-public mirror the
//     friend features read: identity plus competitive totals, and
//     nothing else. Owner-writes-only with a closed field whitelist;
//     readable by any signed-in user.
//
//     **MVP trust model: these values are self-reported.** They are
//     computed and written by the owner's own client, so these rules
//     guarantee *who wrote them* — nobody can inflate another user's
//     figures, delete them, or post under their name — but not that the
//     numbers are true. That is acceptable for friends-scale
//     competition, where the worst available cheat is overstating your
//     own driving to people who invited you.
//
//     **Do not widen the read rule to build a public leaderboard of
//     strangers.** That is the point at which validation has to move to
//     a server-authoritative path, not the point at which this surface
//     gets shared more widely. Same for prizes or paid competition.
//
//   - `usernames/{usernameLower}` — one document per claimed name, the
//     lock that makes a username resolve to exactly one account.
//     Create-only: reservations are permanent by decision, so a name is
//     never released or transferred (see UsernameReservationService).
//
//   - `users/{uid}` — public profile (username, car, country, photo URL,
//     lifetime top speed) + `users/{uid}/trips/{remoteId}` — full trip
//     detail including waypoints (inline or chunked). Owner-only:
//     PII/private trip data lives here, so unlike `device_trials`, reads
//     AND writes are bound to `request.auth.uid == uid`. (A future
//     leaderboard/friend-search feature would read from a separate,
//     deliberately-public mirror collection — not from here — precisely
//     because Firestore rules can't expose a subset of one document's
//     fields to other users; see the sync-feature plan for that
//     reasoning.)
//
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Owner-only — this doc carries real PII (username, car, photo),
      // not the anonymous device-trial counter below. No other
      // authenticated user can read or write it.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'username', 'usernameLower', 'carMake', 'carModel',
                        'carYear', 'carName', 'carPhotoUrl', 'countryCode',
                        'topSpeedKmh', 'updatedAt'
                      ]);
      allow delete: if false; // account deletion uses an explicit client
                               // delete via CloudSyncService, not this rule.

      match /trips/{tripId} {
        // Private — only the owner ever reads/writes their own trip
        // detail. No public surface reads this subcollection.
        allow read, write, delete: if request.auth != null
                                    && request.auth.uid == uid;

        match /waypointChunks/{chunkId} {
          allow read, write, delete: if request.auth != null
                                      && request.auth.uid == uid;
        }
      }
    }

    // The public competition mirror. Note the asymmetry with
    // `users/{uid}` above: that document is owner-read because it holds
    // PII; this one exists precisely to be read by other people, which
    // is why it is a separate document holding a deliberately narrow
    // field set rather than a widened rule on the private one.
    match /public_profiles/{uid} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'username', 'usernameLower', 'carMake', 'carModel',
                        'countryCode', 'inviteCode', 'updatedAt',
                        'distance_weekly', 'distance_monthly',
                        'distance_allTime',
                        'longestTrip_weekly', 'longestTrip_monthly',
                        'longestTrip_allTime',
                        'consistency_weekly', 'consistency_monthly',
                        'consistency_allTime'
                      ]);

      // Account deletion removes this through the same explicit client
      // path that clears `users/{uid}` — see CloudSyncService.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Username reservations. The document *is* the lock: a create is
    // only valid when the name is free, so two clients racing for the
    // same name resolve here with exactly one winner rather than in
    // application code that can't be trusted to be atomic.
    match /usernames/{usernameLower} {
      // Readable so the app can answer "is this taken" before a claim.
      // A reservation holds only a uid and a timestamp — no PII.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'claimedAt']);

      // Never updated, never deleted, never transferred. Releasing a
      // name would let a handle that appears in someone's friend list be
      // re-claimed by a different person, who would inherit that
      // history.
      allow update, delete: if false;
    }

    // Friend requests, at a deterministic path: `{fromUid}_{toUid}`.
    //
    // The id is derived rather than random because the friendship rule
    // below has to *name* the request that authorises it. A rule's
    // get() takes a concrete path — rules have no query, so "is there
    // an accepted request between these two people" is not a question
    // that can be asked unless the answer lives at a computable
    // address. It also makes "one live request per direction"
    // structural instead of a convention application code has to
    // remember.
    match /friend_requests/{requestId} {
      function request_() { return request.resource.data; }
      function existing() { return resource.data; }
      function isParty() {
        return request.auth != null
               && (request.auth.uid == existing().fromUid
                   || request.auth.uid == existing().toUid);
      }
      // fromUid and toUid may never change. The friendship rule reads
      // exactly those to decide, so a mutable toUid would let a request
      // be redirected at a third party after the fact.
      function identityUnchanged() {
        return request_().fromUid == existing().fromUid
               && request_().toUid == existing().toUid;
      }

      // createdAt is pinned on every transition except one: the
      // sender's re-send after a withdrawal.
      //
      // A re-send has to be a single unconditional `set`, because the
      // client cannot read the document first to learn whether it
      // exists — a rules read of a missing document evaluates against a
      // null resource and is denied rather than answered — so one
      // write has to serve as both create and re-send. That write
      // necessarily carries a fresh createdAt. Nothing authorises on
      // createdAt, and a re-send resetting "asked at" is honest: it is
      // a new ask. Every other transition is a narrow status update, so
      // it keeps the original.
      function createdAtUnchanged() {
        return request_().createdAt == existing().createdAt;
      }

      allow read: if isParty();

      allow create: if request.auth != null
                    && request.auth.uid == request_().fromUid
                    && request_().fromUid != request_().toUid
                    && requestId == request_().fromUid + '_' + request_().toUid
                    && request_().status == 'pending'
                    && request_().keys().hasOnly(
                         ['fromUid', 'toUid', 'status',
                          'createdAt', 'updatedAt']);

      // Whether the *other* direction shows these two were once
      // actually friends. `accepted` is a live friendship; `ended` is
      // one that was unfriended. Either way they agreed at some point,
      // which is what supersedes an older decline — see below.
      function reverseShowsFriendship() {
        return exists(/databases/$(database)/documents/friend_requests/$(existing().toUid + '_' + existing().fromUid))
               && get(/databases/$(database)/documents/friend_requests/$(existing().toUid + '_' + existing().fromUid))
                    .data.status in ['accepted', 'ended'];
      }

      // The recipient decides. `accepted` is terminal, and `declined`
      // is terminal *between strangers*: nothing un-declines, and the
      // person who declined can still send their own request at the
      // other document id, so the decision to reconnect belongs to
      // whoever said no. Terminality is the whole anti-spam mechanism
      // here — without it a declined asker can re-ask on a loop — so
      // it does not come off lightly.
      allow update: if request.auth != null
                    && identityUnchanged()
                    && (
                      (request.auth.uid == existing().toUid
                       && existing().status == 'pending'
                       && createdAtUnchanged()
                       && (request_().status == 'accepted'
                           || request_().status == 'declined'))
                      ||
                      // The sender may withdraw, and may ask again
                      // afterwards — cancelling by mistake must not
                      // lock someone out permanently, and neither must
                      // unfriending. The re-send is the one write
                      // allowed to carry a new createdAt; see
                      // createdAtUnchanged() for why it has to be.
                      //
                      // `ended` re-opens for the same reason. It marks
                      // a friendship that was deleted, and a request id
                      // is derived from the pair — so "re-friending
                      // starts a new request" cannot mean a new
                      // document: there is exactly one address for
                      // these two people in this direction. Leaving
                      // `ended` fully terminal therefore meant two
                      // people who unfriended could never become
                      // friends again, from either side. Re-opening
                      // grants nothing on its own: the recipient still
                      // has to accept before any friendship can be
                      // created, and the sync's healing pass only ever
                      // heals `accepted`.
                      (request.auth.uid == existing().fromUid
                       && ((existing().status == 'pending'
                            && request_().status == 'cancelled'
                            && createdAtUnchanged())
                           || ((existing().status == 'cancelled'
                                || existing().status == 'ended')
                               && request_().status == 'pending')
                           // A decline that the two of them have since
                           // overtaken by actually being friends. Found
                           // on a real pair: an early decline in one
                           // direction, a friendship formed through the
                           // other, then an unfriend — which left the
                           // person who had been declined unable to ask
                           // again, for a "no" the friendship itself had
                           // already superseded. A stranger's decline
                           // still blocks permanently: this needs the
                           // other party to have genuinely befriended
                           // them, which only they could have done.
                           || (existing().status == 'declined'
                               && request_().status == 'pending'
                               && reverseShowsFriendship())))
                      ||
                      // Either party may end an accepted request when
                      // they unfriend. Without this, "accepted request
                      // with no friendship" stays indistinguishable
                      // from "the friendship write never landed", and
                      // the sync's self-healing pass recreates a
                      // friendship that was deliberately ended.
                      // `ended` stops the healing pass, which only
                      // acts on `accepted`. It is not fully terminal:
                      // the sender may re-open it as `pending` above,
                      // because a pair-derived id leaves nowhere else
                      // for a fresh request to live.
                      (isParty()
                       && existing().status == 'accepted'
                       && request_().status == 'ended'
                       && createdAtUnchanged())
                    );

      // History survives. A deletable request would make a decline
      // invisible and re-sendable.
      allow delete: if false;
    }

    // One document per friendship, keyed on both uids sorted — so the
    // same pair resolves to the same document from either side.
    //
    // Deliberately not mirrored per-user documents: mirroring means
    // accepting writes into somebody else's subtree, and a failed
    // second write would leave one side friends and the other not, with
    // no server to reconcile it. One document either exists or doesn't.
    match /friendships/{pairKey} {
      function data() { return request.resource.data; }
      function accepted(a, b) {
        return exists(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
               && get(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
                    .data.status == 'accepted';
      }

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.uids;

      // Either party may create it, but only on the strength of an
      // accepted request between *exactly these two* — checked at both
      // derived paths, since either of them may have been the sender.
      // The key is forced to agree with the contents, so a well-formed
      // document cannot describe a different pair than its address.
      allow create: if request.auth != null
                    && data().keys().hasOnly(['uids', 'createdAt'])
                    && data().uids.size() == 2
                    && data().uids[0] < data().uids[1]
                    && pairKey == data().uids[0] + '_' + data().uids[1]
                    && request.auth.uid in data().uids
                    && (accepted(data().uids[0], data().uids[1])
                        || accepted(data().uids[1], data().uids[0]));

      // Immutable once created — there is nothing in it to change, and
      // an updatable uids array would be a way to rewrite who is
      // friends with whom.
      allow update: if false;

      // Unfriending is mutual by construction: one document, either
      // party may remove it.
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.uids;
    }

    // Threat model and what these rules guarantee:
    //   - Reads/writes require Firebase Auth (anonymous is fine —
    //     bootstrap ensures a signed-in user before any cloud call).
    //   - Doc IDs are sha256 hex strings; clients cannot guess another
    //     install's hash without the raw device ID, which is per-device-
    //     private. So in practice a malicious authenticated user cannot
    //     write to a *specific* other user's counter, even though these
    //     rules don't bind the doc id to the auth uid.
    //   - The counter is monotonically increasing (anti-abuse), enforced
    //     server-side: a write is only valid if `freeTripsUsed` is >= the
    //     existing value. A malicious client cannot reset its own counter
    //     to 0 to refresh the trial.
    //   - No PII is ever stored here, so there's no need to bind to uid
    //     (unlike `users/{uid}` above).
    match /device_trials/{deviceHash} {
      // Anyone signed in (including anonymous) can read their own
      // counter. They can read others' too, but doc ids are unguessable.
      allow read: if request.auth != null
                  && deviceHash.matches('^[a-f0-9]{64}$');

      // Create: first write for this device. Must start at >= 0 and
      // include a freeTripsUsed field of type int.
      allow create: if request.auth != null
                    && deviceHash.matches('^[a-f0-9]{64}$')
                    && request.resource.data.keys().hasOnly(
                         ['freeTripsUsed', 'updatedAt'])
                    && request.resource.data.freeTripsUsed is int
                    && request.resource.data.freeTripsUsed >= 0;

      // Update: monotonically increasing only. A client cannot lower
      // its own counter — that's the whole point of the anti-abuse
      // gate. Also keep the schema closed (no other fields written).
      allow update: if request.auth != null
                    && deviceHash.matches('^[a-f0-9]{64}$')
                    && request.resource.data.keys().hasOnly(
                         ['freeTripsUsed', 'updatedAt'])
                    && request.resource.data.freeTripsUsed is int
                    && request.resource.data.freeTripsUsed
                         >= resource.data.freeTripsUsed;

      // Deletes are never allowed.
      allow delete: if false;
    }

    // -----------------------------------------------------------------
    // Challenges — the first record whose outcome depends on two
    // people's writes.
    //
    // Everything else in this file has one shape: an account writes only
    // its own values, and a reader *orders* independently-owned numbers.
    // No document decides anything about anybody else. A challenge
    // produces a result, so it gets its own reasoning:
    //
    //  * **No winner is stored.** Each participant owns
    //    `progress/{their uid}` and nobody else may write it, so the
    //    result is a reading of two numbers rather than a verdict one
    //    client could forge and the other could only dispute.
    //  * **The terms are immutable** once written. A mutable target or
    //    window would let a creator move the goalposts after seeing how
    //    it was going.
    //  * **Progress freezes** at `endAt + 6h` (below), so a settled
    //    result cannot be rewritten afterwards.
    //
    // What these rules do NOT do is make the figures true: progress is
    // computed on the owner's device from the owner's trips, exactly as
    // `public_profiles` totals are. A determined person can overstate
    // their driving and win. That is acceptable at friends scale with
    // nothing at stake, and ONLY there. **The moment a challenge carries
    // a prize, a payment or public standing, progress must come from a
    // server-authoritative path** — do not read this block as
    // permission to widen that.
    // -----------------------------------------------------------------
    match /challenges/{challengeId} {
      function data() { return request.resource.data; }
      function existing() { return resource.data; }
      function friendshipExists(a, b) {
        return exists(/databases/$(database)/documents/friendships/$(a < b ? a + '_' + b : b + '_' + a));
      }
      // Terms may never change. The result is derived from them, so a
      // mutable metric, target or window is a way to rewrite an outcome
      // without touching a single progress figure.
      function termsUnchanged() {
        return data().participants == existing().participants
               && data().creatorUid == existing().creatorUid
               && data().opponentUid == existing().opponentUid
               && data().metric == existing().metric
               && data().targetValue == existing().targetValue
               && data().period == existing().period
               && data().startAt == existing().startAt
               && data().endAt == existing().endAt
               && data().createdAt == existing().createdAt;
      }

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;

      // The creator opens it, against somebody they are already friends
      // with — the friendship document's id is derived from the sorted
      // pair, which is what makes it nameable here at all, since rules
      // have no query.
      //
      // **startAt must be roughly now.** A challenge measures
      // `[creation, period end)`, NOT the period's own start — the
      // window a target uses. `CompetitionWindow.forPeriod(weekly, …)`
      // begins on Monday, so a challenge created on Thursday that
      // inherited it would hand the creator every kilometre they had
      // already driven that week as a head start the opponent cannot
      // see. The creator chooses when to challenge; they must not also
      // choose which of their past driving counts.
      //
      // endAt is bounded so a challenge cannot be given a window so
      // long it never settles. 400 days covers the longest legitimate
      // one (all-time targets are scoped to the year's end).
      allow create: if request.auth != null
                    && request.auth.uid == data().creatorUid
                    && data().creatorUid != data().opponentUid
                    && data().keys().hasOnly(
                         ['participants', 'creatorUid', 'opponentUid',
                          'metric', 'targetValue', 'period',
                          'startAt', 'endAt', 'status',
                          'createdAt', 'updatedAt'])
                    && data().participants.size() == 2
                    && data().participants[0] < data().participants[1]
                    && data().creatorUid in data().participants
                    && data().opponentUid in data().participants
                    && data().status == 'pending'
                    && data().targetValue > 0
                    && data().startAt <= request.time + duration.value(10, 'm')
                    && data().startAt >= request.time - duration.value(10, 'm')
                    && data().endAt > data().startAt
                    && data().endAt < data().startAt + duration.value(400, 'd')
                    && friendshipExists(data().creatorUid, data().opponentUid);

      // `active` is the accepted state, spelled the way
      // `ChallengeStatus` spells it. One vocabulary across the rules,
      // the entity and the database — a translation layer between two
      // words for one state is a place for them to drift.
      //
      // Only the negotiation moves. `completed` and `expired` are
      // deliberately absent: an outcome is derived from the two frozen
      // figures, never written, so there is no terminal state here for
      // anybody to fabricate.
      //
      // Acceptance additionally requires the window still to be open.
      // Both participants must agree to compete BEFORE the competition
      // ends — otherwise a challenge left pending until 23:59 Sunday
      // could be accepted at 01:00 Monday and then have progress
      // published during the finalization grace, competing entirely
      // after the window it was meant to measure.
      //
      // Declining and cancelling stay allowed after `endAt`: they only
      // tidy a dead challenge away and cannot manufacture a result.
      allow update: if request.auth != null
                    && termsUnchanged()
                    && existing().status == 'pending'
                    && (
                      (request.auth.uid == existing().opponentUid
                       && ((data().status == 'active'
                            && request.time < existing().endAt)
                           || data().status == 'declined'))
                      ||
                      (request.auth.uid == existing().creatorUid
                       && data().status == 'cancelled')
                    );

      // History survives, exactly as it does for friend requests: a
      // deletable challenge would make a loss disappear.
      allow delete: if false;

      // ---------------------------------------------------------------
      // One document per participant, and only its owner may write it.
      // This is the security boundary of the whole phase: B must not be
      // able to write A's figure, in any shape.
      // ---------------------------------------------------------------
      match /progress/{ownerUid} {
        function parent() {
          return get(/databases/$(database)/documents/challenges/$(challengeId));
        }

        allow read: if request.auth != null
                    && request.auth.uid in parent().data.participants;

        // **The finalization boundary.** The competition ends at
        // `endAt`; the figures freeze six hours later, and the result is
        // only final at that freeze. The grace exists so a drive taken
        // immediately before `endAt` can still be published once the app
        // is next opened — bounded, so the result does become final.
        //
        // This 6h MUST equal `kChallengeFinalizationGrace` in
        // `challenge_settlement.dart`; `challenge_rules_contract_test`
        // parses it out of this file and fails if the two drift apart.
        //
        // Deliberately NOT monotonic: deleting a trip must lower the
        // figure, which is this feature's load-bearing rule.
        //
        // The friendship is a creation-time precondition on the parent
        // only. Nothing here consults it, so **unfriending does not
        // cancel an accepted challenge** — an accidental unfriend, or a
        // fallout mid-week, must not destroy a live competition or
        // freeze one person's figure while the other's keeps moving. Do
        // not "tighten" this into a continuous eligibility check.
        allow write: if request.auth != null
                     && request.auth.uid == ownerUid
                     && ownerUid in parent().data.participants
                     && parent().data.status == 'active'
                     && request.time < parent().data.endAt + duration.value(6, 'h')
                     && request.resource.data.keys().hasOnly(
                          ['value', 'updatedAt'])
                     && request.resource.data.value >= 0;
      }
    }

    // Anything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// -----------------------------------------------------------------------------
// Deploying this file
// -----------------------------------------------------------------------------
// Nothing deploys these rules automatically — `codemagic.yaml` has no
// Firestore step. Until they are deployed, every path added for the
// social features is denied by the catch-all at the bottom, so the
// feature fails closed: it looks broken rather than becoming insecure.
//
//   firebase login                       # once
//   firebase deploy --only firestore:rules --project drive-rank
//
// Verify locally first — the suite covers the allow *and* deny side of
// every rule here:
//
//   cd test/rules && npm install         # once
//   firebase emulators:exec --only firestore "npm --prefix test/rules test"
