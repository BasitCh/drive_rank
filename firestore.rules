rules_version = '2';

// =============================================================================
// DriveRank Firestore security rules
// =============================================================================
//
// Collections:
//   - `device_trials/{hash}` — the anti-abuse free-trip counter, keyed by
//     a sha256 hash of the device's ANDROID_ID (Android) or
//     identifierForVendor (iOS). No PII, doc ids are unguessable.
//   - `public_profiles/{uid}` — the deliberately-public mirror the
//     friend features read: identity plus competitive totals, and
//     nothing else. Owner-writes-only with a closed field whitelist;
//     readable by any signed-in user.
//
//     **MVP trust model: these values are self-reported.** They are
//     computed and written by the owner's own client, so these rules
//     guarantee *who wrote them* — nobody can inflate another user's
//     figures, delete them, or post under their name — but not that the
//     numbers are true. That is acceptable for friends-scale
//     competition, where the worst available cheat is overstating your
//     own driving to people who invited you.
//
//     **Do not widen the read rule to build a public leaderboard of
//     strangers.** That is the point at which validation has to move to
//     a server-authoritative path, not the point at which this surface
//     gets shared more widely. Same for prizes or paid competition.
//
//   - `usernames/{usernameLower}` — one document per claimed name, the
//     lock that makes a username resolve to exactly one account.
//     Create-only: reservations are permanent by decision, so a name is
//     never released or transferred (see UsernameReservationService).
//
//   - `users/{uid}` — public profile (username, car, country, photo URL,
//     lifetime top speed) + `users/{uid}/trips/{remoteId}` — full trip
//     detail including waypoints (inline or chunked). Owner-only:
//     PII/private trip data lives here, so unlike `device_trials`, reads
//     AND writes are bound to `request.auth.uid == uid`. (A future
//     leaderboard/friend-search feature would read from a separate,
//     deliberately-public mirror collection — not from here — precisely
//     because Firestore rules can't expose a subset of one document's
//     fields to other users; see the sync-feature plan for that
//     reasoning.)
//
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Owner-only — this doc carries real PII (username, car, photo),
      // not the anonymous device-trial counter below. No other
      // authenticated user can read or write it.
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'username', 'usernameLower', 'carMake', 'carModel',
                        'carYear', 'carName', 'carPhotoUrl', 'countryCode',
                        'topSpeedKmh', 'updatedAt'
                      ]);
      allow delete: if false; // account deletion uses an explicit client
                               // delete via CloudSyncService, not this rule.

      match /trips/{tripId} {
        // Private — only the owner ever reads/writes their own trip
        // detail. No public surface reads this subcollection.
        allow read, write, delete: if request.auth != null
                                    && request.auth.uid == uid;

        match /waypointChunks/{chunkId} {
          allow read, write, delete: if request.auth != null
                                      && request.auth.uid == uid;
        }
      }
    }

    // The public competition mirror. Note the asymmetry with
    // `users/{uid}` above: that document is owner-read because it holds
    // PII; this one exists precisely to be read by other people, which
    // is why it is a separate document holding a deliberately narrow
    // field set rather than a widened rule on the private one.
    match /public_profiles/{uid} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.data.keys().hasOnly([
                        'username', 'usernameLower', 'carMake', 'carModel',
                        'countryCode', 'inviteCode', 'updatedAt',
                        'distance_weekly', 'distance_monthly',
                        'distance_allTime',
                        'longestTrip_weekly', 'longestTrip_monthly',
                        'longestTrip_allTime',
                        'consistency_weekly', 'consistency_monthly',
                        'consistency_allTime'
                      ]);

      // Account deletion removes this through the same explicit client
      // path that clears `users/{uid}` — see CloudSyncService.
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Username reservations. The document *is* the lock: a create is
    // only valid when the name is free, so two clients racing for the
    // same name resolve here with exactly one winner rather than in
    // application code that can't be trusted to be atomic.
    match /usernames/{usernameLower} {
      // Readable so the app can answer "is this taken" before a claim.
      // A reservation holds only a uid and a timestamp — no PII.
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['uid', 'claimedAt']);

      // Never updated, never deleted, never transferred. Releasing a
      // name would let a handle that appears in someone's friend list be
      // re-claimed by a different person, who would inherit that
      // history.
      allow update, delete: if false;
    }

    // Friend requests, at a deterministic path: `{fromUid}_{toUid}`.
    //
    // The id is derived rather than random because the friendship rule
    // below has to *name* the request that authorises it. A rule's
    // get() takes a concrete path — rules have no query, so "is there
    // an accepted request between these two people" is not a question
    // that can be asked unless the answer lives at a computable
    // address. It also makes "one live request per direction"
    // structural instead of a convention application code has to
    // remember.
    match /friend_requests/{requestId} {
      function request_() { return request.resource.data; }
      function existing() { return resource.data; }
      function isParty() {
        return request.auth != null
               && (request.auth.uid == existing().fromUid
                   || request.auth.uid == existing().toUid);
      }
      // fromUid, toUid and createdAt may never change. The friendship
      // rule reads exactly those fields to decide, so a mutable toUid
      // would let a request be redirected at a third party after the
      // fact.
      function identityUnchanged() {
        return request_().fromUid == existing().fromUid
               && request_().toUid == existing().toUid
               && request_().createdAt == existing().createdAt;
      }

      allow read: if isParty();

      allow create: if request.auth != null
                    && request.auth.uid == request_().fromUid
                    && request_().fromUid != request_().toUid
                    && requestId == request_().fromUid + '_' + request_().toUid
                    && request_().status == 'pending'
                    && request_().keys().hasOnly(
                         ['fromUid', 'toUid', 'status',
                          'createdAt', 'updatedAt']);

      // The recipient decides. accepted and declined are terminal —
      // nothing un-declines, and nothing re-sends into a decline. The
      // person who declined can still send their own request, which is
      // the *other* document id: the decision to reconnect belongs to
      // whoever said no.
      allow update: if request.auth != null
                    && identityUnchanged()
                    && (
                      (request.auth.uid == existing().toUid
                       && existing().status == 'pending'
                       && (request_().status == 'accepted'
                           || request_().status == 'declined'))
                      ||
                      // The sender may withdraw, and may re-send after
                      // withdrawing — cancelling by mistake must not
                      // lock someone out permanently.
                      (request.auth.uid == existing().fromUid
                       && ((existing().status == 'pending'
                            && request_().status == 'cancelled')
                           || (existing().status == 'cancelled'
                               && request_().status == 'pending')))
                    );

      // History survives. A deletable request would make a decline
      // invisible and re-sendable.
      allow delete: if false;
    }

    // One document per friendship, keyed on both uids sorted — so the
    // same pair resolves to the same document from either side.
    //
    // Deliberately not mirrored per-user documents: mirroring means
    // accepting writes into somebody else's subtree, and a failed
    // second write would leave one side friends and the other not, with
    // no server to reconcile it. One document either exists or doesn't.
    match /friendships/{pairKey} {
      function data() { return request.resource.data; }
      function accepted(a, b) {
        return exists(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
               && get(/databases/$(database)/documents/friend_requests/$(a + '_' + b))
                    .data.status == 'accepted';
      }

      allow read: if request.auth != null
                  && request.auth.uid in resource.data.uids;

      // Either party may create it, but only on the strength of an
      // accepted request between *exactly these two* — checked at both
      // derived paths, since either of them may have been the sender.
      // The key is forced to agree with the contents, so a well-formed
      // document cannot describe a different pair than its address.
      allow create: if request.auth != null
                    && data().keys().hasOnly(['uids', 'createdAt'])
                    && data().uids.size() == 2
                    && data().uids[0] < data().uids[1]
                    && pairKey == data().uids[0] + '_' + data().uids[1]
                    && request.auth.uid in data().uids
                    && (accepted(data().uids[0], data().uids[1])
                        || accepted(data().uids[1], data().uids[0]));

      // Immutable once created — there is nothing in it to change, and
      // an updatable uids array would be a way to rewrite who is
      // friends with whom.
      allow update: if false;

      // Unfriending is mutual by construction: one document, either
      // party may remove it.
      allow delete: if request.auth != null
                    && request.auth.uid in resource.data.uids;
    }

    // Threat model and what these rules guarantee:
    //   - Reads/writes require Firebase Auth (anonymous is fine —
    //     bootstrap ensures a signed-in user before any cloud call).
    //   - Doc IDs are sha256 hex strings; clients cannot guess another
    //     install's hash without the raw device ID, which is per-device-
    //     private. So in practice a malicious authenticated user cannot
    //     write to a *specific* other user's counter, even though these
    //     rules don't bind the doc id to the auth uid.
    //   - The counter is monotonically increasing (anti-abuse), enforced
    //     server-side: a write is only valid if `freeTripsUsed` is >= the
    //     existing value. A malicious client cannot reset its own counter
    //     to 0 to refresh the trial.
    //   - No PII is ever stored here, so there's no need to bind to uid
    //     (unlike `users/{uid}` above).
    match /device_trials/{deviceHash} {
      // Anyone signed in (including anonymous) can read their own
      // counter. They can read others' too, but doc ids are unguessable.
      allow read: if request.auth != null
                  && deviceHash.matches('^[a-f0-9]{64}$');

      // Create: first write for this device. Must start at >= 0 and
      // include a freeTripsUsed field of type int.
      allow create: if request.auth != null
                    && deviceHash.matches('^[a-f0-9]{64}$')
                    && request.resource.data.keys().hasOnly(
                         ['freeTripsUsed', 'updatedAt'])
                    && request.resource.data.freeTripsUsed is int
                    && request.resource.data.freeTripsUsed >= 0;

      // Update: monotonically increasing only. A client cannot lower
      // its own counter — that's the whole point of the anti-abuse
      // gate. Also keep the schema closed (no other fields written).
      allow update: if request.auth != null
                    && deviceHash.matches('^[a-f0-9]{64}$')
                    && request.resource.data.keys().hasOnly(
                         ['freeTripsUsed', 'updatedAt'])
                    && request.resource.data.freeTripsUsed is int
                    && request.resource.data.freeTripsUsed
                         >= resource.data.freeTripsUsed;

      // Deletes are never allowed.
      allow delete: if false;
    }

    // Anything else: locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// -----------------------------------------------------------------------------
// Deploying this file
// -----------------------------------------------------------------------------
// Nothing deploys these rules automatically — `codemagic.yaml` has no
// Firestore step. Until they are deployed, every path added for the
// social features is denied by the catch-all at the bottom, so the
// feature fails closed: it looks broken rather than becoming insecure.
//
//   firebase login                       # once
//   firebase deploy --only firestore:rules --project drive-rank
//
// Verify locally first — the suite covers the allow *and* deny side of
// every rule here:
//
//   cd test/rules && npm install         # once
//   firebase emulators:exec --only firestore "npm --prefix test/rules test"
