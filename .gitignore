# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing material — must NEVER be committed.
/android/key.properties
/android/app/upload-keystore.jks
/android/app/release.keystore

# Firebase platform config — generated by `flutterfire configure`. Some
# teams commit these; for now we keep them out and let Codemagic decode
# them from secret env vars at build time.
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/lib/firebase_options.dart

# Env files
.env
.env.local
.env.production
.vscode/launch.json
